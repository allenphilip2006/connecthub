# Copy to .env - never commit .env

# Local: Spring Boot on this machine
VITE_API_URL=http://localhost:62223
# Vercel production: set this in the Vercel project env (then Redeploy). Never leave it as localhost.

# Optional Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional Giphy
VITE_GIPHY_API_KEY=
